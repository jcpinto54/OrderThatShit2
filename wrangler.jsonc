{
  "$schema": "node_modules/wrangler/config-schema.json",
  // This must match the Worker that Cloudflare Workers Builds deploys from this repo.
  "name": "orderthatshit2",
  "compatibility_date": "2026-09-01",
  // Assets-only Worker: no server code, just the Vite build in dist/.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  // No "routes" key on purpose. orderthatshit.com and www are attached to this Worker in
  // the Cloudflare dashboard, and Wrangler overwrites the route list with whatever is in
  // this file on every deploy. Declaring them here would fight the dashboard and, on the
  // apex, fail outright because that hostname already has hand-made DNS records.
  // See https://developers.cloudflare.com/workers/wrangler/configuration/#source-of-truth
  "workers_dev": true,
  "observability": { "enabled": true }
}
