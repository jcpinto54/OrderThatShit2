{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orderthatshit",
  "compatibility_date": "2026-09-01",
  // Assets-only Worker: no server code, just the Vite build in dist/.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  // Custom Domains: Cloudflare creates the DNS records and certificates on deploy.
  // The zone must already be on the account that the API token belongs to.
  "routes": [
    { "pattern": "orderthatshit.com", "custom_domain": true },
    { "pattern": "www.orderthatshit.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
